/target
/web/dist
# Bench wasm copied next to the mobile page by solver-lab/web/serve.sh, and the
# results phones POST back.
/solver-lab/web/solver_lab.wasm
/solver-lab/web/results.jsonl

# generator-lab: built wasm copied into web/, and phone-reported results
generator-lab/web/generator_lab.wasm
generator-lab/web/results.jsonl

.claude/
# Python bytecode caches (e.g. the grader-tuning analysis scripts).
__pycache__/
# Pregenerated at build by Trunk pre_build hooks: version from the git commit
# (web/version.js -> backend client_version) and the backend endpoint/key
# (web/backend-config.js, retargetable per build env). curriculum.js is now
# hand-authored source (web/curriculum.js), no longer generated.
/web/version.js
/web/backend-config.js

# Local backend dev (scripts/dev-local): the wrangler-dev secret file and the
# persisted local D1 state. Delete /worker/.wrangler to reset the local database.
/worker/.dev.vars
/worker/.wrangler/

# External Sudoku datasets for grader tuning (large; fetched, not versioned).
/datasets
