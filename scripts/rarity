#!/usr/bin/env python3
"""Sweep every Expert forced spec (single / double / triple) through the `harvest` example to
quantify how rare each is, and capture a few seed -> puzzle samples per yielding spec as test
fixtures.

The enumeration and the resume bookkeeping live here; `harvest` itself only scans one CLI-given
spec over one CLI-given seed window and reports `hits`/`next`. Each strip attempt is an
independent 1/X chance of yielding, so rarity is just hits/attempts; rarity.csv reports
`one_in = attempts // hits` (= X). A common spec pins X in a few thousand attempts; a rare one
reads as 0 hits over the budget (X then only known to exceed it).

Pick a spec-list (all / single / double / triple) and one --attempts budget; per-tier budgets
are just separate runs. Resumable: rarity.csv stores cumulative `attempts` per spec, so a rerun
continues at seed = base + attempts and never rescans the same (usually empty) range. Start
cheap, then deepen only the low/no-yield rows:

    scripts/rarity                                  # cheap sweep of everything (default attempts)
    scripts/rarity triple --attempts 5000           # just the triples, cheaper
    scripts/rarity --max-hits 5 --attempts 1000000  # deepen every row still under 5 hits
    scripts/rarity --attempt-cap 1000000            # bring every spec up to 1,000,000 attempts
    scripts/rarity report                           # confidence intervals + a readable table
    scripts/rarity --update-tests                   # ...and refresh the committed test fixtures

Hit-count window: --min-hits / --max-hits select which rows to (re)scan by their CURRENT hit
count -- scan iff `min-hits <= hits < max-hits`. Use --max-hits 5 to deepen only the rare rows
(under 5 hits); use --min-hits to skip the truly-never-yielded rows and tighten the common ones.

Same-cap deepening: --attempt-cap N brings specs that have logged different amounts of mining all
up to the same N total attempts. Per spec it adds `min(--attempts, N - current)` so it never
overshoots; with no --attempts it adds exactly `N - current` (fills to the cap in one run) and
skips rows already at N.

Interruptible: Ctrl-C stops the sweep, cancels what hasn't started, and still writes the rarity
table (and sample fixtures) with whatever the finished specs found -- so a long run is never lost.

What touches your tests: ONLY --update-tests. By default the run writes the rarity table
(rarity.csv) and a throwaway copy of the captured sample fixtures under target/, and leaves the
committed test fixtures alone -- so you can poke at it freely. rarity.csv is never a test input.
Add --update-tests to (re)write generator-lab/tests/fixtures/harvest, which the reconstruction
test replays.

Combinations over the 12 Expert kinds (multisets, so X:2 / X:3 are included):
12 singles, 78 doubles, 364 triples = 454 specs.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import itertools
import math
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from statistics import NormalDist

# The 12 Expert kinds, in taxonomy order (naked-pair .. w-wing).
KINDS = [
    "naked-pair", "hidden-pair", "naked-triple", "hidden-triple", "naked-quad", "hidden-quad",
    "x-wing", "swordfish", "jellyfish", "xy-wing", "xyz-wing", "w-wing",
]
TIER_NAME = {1: "single", 2: "double", 3: "triple"}
DEFAULT_ATTEMPTS = 10_000


def group(multiset):
    """A sorted multiset of kind names -> (key, force_args). `key` is '+'-joined NAME[:COUNT]
    (the CSV key and fixture force tokens); `force_args` is the matching --force argv."""
    toks, fargs = [], []
    for name, grp in itertools.groupby(multiset):
        c = sum(1 for _ in grp)
        tok = name if c == 1 else f"{name}:{c}"
        toks.append(tok)
        fargs += ["--force", tok]
    return "+".join(toks), fargs


def size_of_key(key):
    """Multiset size (sum of counts) of a spec key, e.g. `x-wing:2+swordfish` -> 3."""
    return sum(int(t.split(":")[1]) if ":" in t else 1 for t in key.split("+"))


def enumerate_specs(tier):
    """(key, force_args) for every spec in the requested tier(s), singles then doubles then triples."""
    jobs = []
    if tier in ("all", "single"):
        jobs += [group((k,)) for k in KINDS]
    if tier in ("all", "double"):
        jobs += [group(c) for c in itertools.combinations_with_replacement(KINDS, 2)]
    if tier in ("all", "triple"):
        jobs += [group(c) for c in itertools.combinations_with_replacement(KINDS, 3)]
    return jobs


def load_csv(path):
    """rarity.csv -> {key: [attempts, hits]} (the resume state)."""
    state = {}
    if path.exists():
        for line in path.read_text().splitlines()[1:]:  # skip header
            f = line.split(",")
            if len(f) >= 4 and f[1]:
                state[f[1]] = [int(f[2]), int(f[3])]
    return state


def parse_fixture(text):
    """A fixture file -> [{key, toolbox, pairs}], one per blank-line-separated record."""
    recs = []
    for block in re.split(r"\n\s*\n", text):
        forces, toolbox, pairs = [], "train", []
        for line in block.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            head, _, rest = line.partition(" ")
            if head == "force":
                forces.append(rest.strip())
            elif head == "toolbox":
                toolbox = rest.strip()
            elif head == "sample":
                seed, _, puz = rest.strip().partition(" ")
                pairs.append((seed, puz))
        if forces:
            recs.append({"key": "+".join(forces), "toolbox": toolbox, "pairs": pairs})
    return recs


def load_samples(fixdir):
    """The committed scan fixtures are the persistent sample store; read them back so an
    iterate pass keeps the samples it already captured. -> {key: {toolbox, pairs}}."""
    samples = {}
    for tier in TIER_NAME.values():
        p = fixdir / f"scan-{tier}s.txt"
        if p.exists():
            for rec in parse_fixture(p.read_text()):
                samples[rec["key"]] = {"toolbox": rec["toolbox"], "pairs": rec["pairs"]}
    return samples


def write_csv(path, state):
    """rarity.csv, sorted by tier, then commonest first (smallest one_in), 0-hit specs last."""
    rows = []
    for key, (att, hit) in state.items():
        size = size_of_key(key)
        one_in = att // hit if hit else None
        rank = one_in if hit else 1 << 60  # X unknown -> last within its tier
        rows.append((size, rank, key, att, hit, one_in))
    rows.sort()
    lines = ["tier,spec,attempts,hits,one_in"]
    for size, _rank, key, att, hit, one_in in rows:
        lines.append(f"{TIER_NAME[size]},{key},{att},{hit},{'' if one_in is None else one_in}")
    path.write_text("\n".join(lines) + "\n")


def write_fixtures(fixdir, samples):
    """Regenerate the per-tier sample fixtures from the (merged) sample store."""
    fixdir.mkdir(parents=True, exist_ok=True)
    for size, tier in TIER_NAME.items():
        items = sorted((k, r) for k, r in samples.items() if size_of_key(k) == size)
        if not items:
            continue
        out = [
            f"# generator-lab rarity-scan sample fixtures ({tier} specs). Regenerate via",
            "# scripts/rarity. Positive-only: each 'sample' seed must still reconstruct its",
            "# puzzle (no window => no negative claim). See tests/harvest_reconstructs.rs.",
        ]
        for key, rec in items:
            out.append("")
            out += [f"force {t}" for t in key.split("+")]
            out.append(f"toolbox {rec['toolbox']}")
            out += [f"sample {seed} {puz}" for seed, puz in rec["pairs"]]
        (fixdir / f"scan-{tier}s.txt").write_text("\n".join(out) + "\n")


def scan(argv):
    ap = argparse.ArgumentParser(prog="rarity", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("tier", nargs="?", default="all", choices=["all", "single", "double", "triple"],
                    help="which spec-list to scan (default all)")
    ap.add_argument("--attempts", type=int, default=None,
                    help=f"attempts to add per spec this run (default {DEFAULT_ATTEMPTS:,}); with "
                         "--attempt-cap and no --attempts, each spec is filled straight to the cap")
    ap.add_argument("--attempt-cap", type=int, default=None,
                    help="bring every spec up to this many TOTAL attempts: add only "
                         "min(--attempts, cap - current) per spec, and skip rows already at the cap")
    ap.add_argument("--jobs", type=int, default=1,
                    help="parallel harvest processes; mining goes ~Nx faster (default 1, sequential)")
    ap.add_argument("--min-hits", type=int, default=None,
                    help="only (re)scan specs with AT LEAST this many hits (lower edge of the window)")
    ap.add_argument("--max-hits", type=int, default=None,
                    help="only (re)scan specs with FEWER than this many hits -- deepen the rare ones")
    ap.add_argument("--toolbox", default="train", choices=["train", "drill", "full"])
    ap.add_argument("--seed", type=int, default=1, help="seed base; resume continues at base+attempts")
    ap.add_argument("--samples", type=int, default=4,
                    help="seed -> puzzle pairs to capture per yielding spec, written as 'sample' lines "
                         "into the fixture files -- which land in the scratch dir by default, or the "
                         "committed test dir under --update-tests (where the reconstruction test "
                         "replays them). Applies either way; more = stronger check, bigger files")
    ap.add_argument("--update-tests", action="store_true",
                    help="write the sample fixtures into the COMMITTED test dir "
                         "(generator-lab/tests/fixtures/harvest) -- the ONLY option here that touches "
                         "your tests. Without it they go to a scratch dir under target/")
    ap.add_argument("--csv", default=None,
                    help="rarity table + resume state (default generator-lab/rarity.csv); never a "
                         "test input, so writing it cannot affect tests")
    a = ap.parse_args(argv)

    # Resolve the per-spec attempt chunk. `chunk is None` means "fill straight to --attempt-cap"
    # (only reachable when a cap is set), otherwise it's a fixed budget added per spec this run.
    if a.attempts is not None:
        chunk = a.attempts
    elif a.attempt_cap is not None:
        chunk = None
    else:
        chunk = DEFAULT_ATTEMPTS

    root = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"],
                               capture_output=True, text=True, check=True).stdout.strip())
    os.chdir(root)
    csv_path = Path(a.csv) if a.csv else root / "generator-lab/rarity.csv"
    # --update-tests is the only path that touches the committed fixtures the test reads;
    # otherwise samples go to a gitignored scratch dir under target/ and tests are untouched.
    fixdir = root / "generator-lab/tests/fixtures/harvest" if a.update_tests else root / "target/rarity-scan"

    print("rarity: building harvest...", file=sys.stderr)
    subprocess.run(["cargo", "build", "--release", "-q", "-p", "generator-lab", "--example", "harvest"], check=True)
    harvest = str(root / "target/release/examples/harvest")

    state = load_csv(csv_path)
    samples = load_samples(fixdir)

    # The specs to scan this run, after the tier + hit-window filters and the attempt-cap
    # skip. `eff` is the attempts to ADD to each spec this run (may vary per spec under a cap).
    todo = []
    for key, fargs in enumerate_specs(a.tier):
        att, hit = state.get(key, [0, 0])
        if a.min_hits is not None and hit < a.min_hits:
            continue  # below the window's lower edge
        if a.max_hits is not None and hit >= a.max_hits:
            continue  # already at/above the window's upper edge -- common enough
        if chunk is None:
            eff = max(0, a.attempt_cap - att)
        else:
            eff = chunk if a.attempt_cap is None else min(chunk, max(0, a.attempt_cap - att))
        if eff <= 0:
            continue  # already at the attempt cap; nothing to add
        todo.append((key, fargs, size_of_key(key), att, hit, eff))

    def run_one(job):
        key, fargs, size, att, hit, eff = job
        p = subprocess.run([harvest, *fargs, "--toolbox", a.toolbox, "--seed", str(a.seed + att),
                            "--attempts", str(eff)], capture_output=True, text=True)
        m = re.search(r"hits=(\d+)", p.stderr)
        # Only a clean exit WITH a hits= line counts; a child killed by our Ctrl-C (or any
        # harvest failure) returns ok=False so we never record a falsely-empty scanned range.
        ok = p.returncode == 0 and m is not None
        h = int(m.group(1)) if m else 0
        pairs = [ln.split(" ", 1) for ln in p.stdout.splitlines() if ln.strip()][: a.samples]
        return job, ok, h, pairs

    # Each spec's scan is independent (own seed range, own warp) -- fan them across --jobs
    # processes and merge as each FINISHES (as_completed, so a slow spec can't stall the
    # progress line). State is updated only here in the main thread.
    total = len(todo)
    print(f"rarity: scanning {total} spec(s) on {a.jobs} job(s)"
          f"{'' if a.attempt_cap is None else f' up to cap {a.attempt_cap:,}'}...", file=sys.stderr)
    done = new_yields = found_now = 0
    interrupted = False
    t_start = last_beat = time.monotonic()
    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=a.jobs) as ex:
            futures = [ex.submit(run_one, job) for job in todo]
            try:
                for fut in concurrent.futures.as_completed(futures):
                    (key, fargs, size, att, hit, eff), ok, h, pairs = fut.result()
                    done += 1
                    if not ok:
                        continue  # interrupted/failed child -- leave this spec's state untouched
                    state[key] = [att + eff, hit + h]
                    found_now += h
                    if h > 0:
                        if key not in samples:  # capture lowest-seed samples the first time it yields
                            samples[key] = {"toolbox": a.toolbox, "pairs": [(s, puz) for s, puz in pairs]}
                        tot = hit + h
                        one_in = (att + eff) // tot
                        if hit == 0:  # a spec we'd never seen yield -- the interesting discovery
                            new_yields += 1
                        tag = "NEW" if hit == 0 else "+"
                        print(f"  {tag:<4}{TIER_NAME[size]} {key}: +{h} this run, {tot} total -> ~1 in {one_in}",
                              file=sys.stderr)
                    now = time.monotonic()
                    if now - last_beat >= 3 or done == total:  # throttled heartbeat with ETA
                        last_beat = now
                        el = now - t_start
                        eta = el / done * (total - done)
                        print(f"[{done}/{total}] {100 * done // total:>3}%  {el:5.0f}s elapsed  ETA {eta:4.0f}s"
                              f"  ({new_yields} new yields, {found_now} puzzles this run)", file=sys.stderr)
            except KeyboardInterrupt:
                interrupted = True
                print("\nrarity: interrupted -- cancelling pending specs, saving progress so far...",
                      file=sys.stderr)
                for f in futures:
                    f.cancel()  # drop not-yet-started specs so shutdown doesn't run them
    finally:
        write_csv(csv_path, state)
        write_fixtures(fixdir, samples)

    yielded = sum(1 for _, hit in state.values() if hit > 0)
    dest = "COMMITTED test fixtures" if a.update_tests else f"scratch {fixdir} (tests untouched)"
    head = "rarity (interrupted)" if interrupted else "rarity"
    print(f"{head}: {found_now} puzzle(s) found this run, {new_yields} new yield(s); "
          f"{len(state)} spec(s), {yielded} with yield -> {csv_path}; samples -> {dest}", file=sys.stderr)


def wilson(h, n, z):
    """Wilson score interval (lo, hi) for the true per-attempt yield probability p, from h hits
    over n attempts at the given z. Beats the naive +/- sqrt(p(1-p)/n) for small p / few hits,
    and degrades gracefully at h=0 (lo=0, hi>0) -- so even a never-yielded spec gets a real bound."""
    if n == 0:
        return (0.0, 1.0)
    phat = h / n
    z2 = z * z
    denom = 1 + z2 / n
    center = (phat + z2 / (2 * n)) / denom
    half = (z / denom) * math.sqrt(phat * (1 - phat) / n + z2 / (4 * n * n))
    return (max(0.0, center - half), min(1.0, center + half))


def report(argv):
    """`scripts/rarity report` -- read rarity.csv and print proper rarity statistics: a Wilson
    confidence interval on each spec's true yield probability (and on its 1-in-X reciprocal), in
    an aligned, human-readable table. Read-only; never touches the CSV, fixtures, or tests."""
    ap = argparse.ArgumentParser(prog="rarity report",
                                 description="confidence intervals + readable table over rarity.csv")
    ap.add_argument("tier", nargs="?", default="all", choices=["all", "single", "double", "triple"],
                    help="which tier to report (default all)")
    ap.add_argument("--conf", type=float, default=95.0, help="confidence level, percent (default 95)")
    ap.add_argument("--csv", default=None, help="rarity table to read (default generator-lab/rarity.csv)")
    a = ap.parse_args(argv)

    root = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"],
                               capture_output=True, text=True, check=True).stdout.strip())
    csv_path = Path(a.csv) if a.csv else root / "generator-lab/rarity.csv"
    state = load_csv(csv_path)
    if not state:
        print(f"rarity report: no data in {csv_path}", file=sys.stderr)
        return

    z = NormalDist().inv_cdf(1 - (1 - a.conf / 100) / 2)

    def fmt(x):
        return "inf" if x == math.inf else f"{round(x):,}"

    # One row per spec: 1-in-X estimate and its confidence interval (inverted from the p interval,
    # so the CI on the RARE end is the small p / large X -- p_lo gives X_hi and vice versa).
    rows_by_tier = {1: [], 2: [], 3: []}
    tot_att = tot_hits = 0
    for key, (att, hit) in state.items():
        size = size_of_key(key)
        if a.tier != "all" and TIER_NAME[size] != a.tier:
            continue
        tot_att += att
        tot_hits += hit
        plo, phi = wilson(hit, att, z)
        x_lo = 1 / phi if phi > 0 else math.inf  # likeliest-end bound (fewest attempts per hit)
        x_hi = 1 / plo if plo > 0 else math.inf  # rarest-end bound
        x_est = att / hit if hit else math.inf
        rows_by_tier[size].append((x_est, key, att, hit, x_lo, x_hi))

    print(f"rarity report  ({a.conf:g}% Wilson confidence interval on the true 1-in-X rarity)")
    print(f"source: {csv_path}")
    print()

    for size in (1, 2, 3):
        rows = rows_by_tier[size]
        if not rows:
            continue
        rows.sort(key=lambda r: (r[0], r[1]))  # commonest first; 0-hit (inf) last
        ny = sum(1 for r in rows if r[3] > 0)
        print(f"== {TIER_NAME[size]} ({len(rows)} specs, {ny} with yield) ==")

        # Pre-format the numeric cells so columns line up under their widest value.
        cells = []
        for x_est, key, att, hit, x_lo, x_hi in rows:
            est = fmt(x_est) if hit else f">= {fmt(x_lo)}"  # 0 hits -> one-sided lower bound
            ci = "--" if not hit else f"{fmt(x_lo)} .. {fmt(x_hi)}"
            cells.append((key, f"{att:,}", f"{hit:,}", est, ci))
        wk = max(len(c[0]) for c in cells)
        wa = max(len(c[1]) for c in cells)
        wh = max(len(c[2]) for c in cells)
        we = max(len(c[3]) for c in cells)
        hdr = f"  {'spec':<{wk}}  {'attempts':>{wa}}  {'hits':>{wh}}  {'1 in':>{we}}  95% CI (1 in)"
        print(hdr.replace("95%", f"{a.conf:g}%"))
        for key, att, hit, est, ci in cells:
            print(f"  {key:<{wk}}  {att:>{wa}}  {hit:>{wh}}  {est:>{we}}  {ci}")
        print()

    specs = sum(len(r) for r in rows_by_tier.values())
    yielded = sum(1 for r in rows_by_tier.values() for row in r if row[3] > 0)
    print(f"summary: {specs} spec(s), {yielded} with yield, "
          f"{tot_att:,} total attempts, {tot_hits:,} total puzzles recorded")


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "report":
        return report(argv[1:])
    return scan(argv)


if __name__ == "__main__":
    main()
